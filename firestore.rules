rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /radi/state {
      allow read: if true;
      // schemaVersion이 없는 구버전 클라이언트의 전체 덮어쓰기를 차단한다.
      allow create: if request.resource.data.schemaVersion >= 3;
      allow update: if request.resource.data.schemaVersion >= 3;
      allow delete: if false;
    }
    // 신입생 수료 관리(newcomer/) — 본 앱 radi/state와 완전히 분리된 문서.
    match /newcomer/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 신입생 큐티 제출물(묵상 글·사진) — 문서 하나가 커지므로 state와 분리해 둔다.
    // 본 앱이 겪은 '한 문서에 몰아넣다 유실' 사고를 되풀이하지 않기 위해서다.
    match /newcomerQT/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 신입생 자기소개서 — 팀장이 올린 파일. 문서 1MB 한도 때문에
    // {id}(메타)와 {id}_c{n}(base64 조각)으로 나눠 담는다.
    match /newcomerIntro/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 26년 하반기 오디션 지원서 — 지원자 한 명당 문서 하나(문서 id = 6자리 실기번호).
    match /newcomerApply/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 신입생 비밀 댓글 — 목사님이 아이 큐티에 남긴다. 큐티 문서는 아이가 통째로
    // 덮어쓰며 저장하므로, 함께 지워지지 않게 문서를 따로 둔다.
    match /newcomerQTComments/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 신입생 알림 — 아이마다 문서 하나. 큐티 사진이 안 들어가 가볍다.
    match /newcomerAlerts/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 부산 장안고 기도모임 '바라다' — barada/site 아래에만 산다(다른 앱과 완전 분리).
    // 익명 마음 나눔(barada/site/inbox)은 누구나 읽히지만 본문이 RSA로 잠겨 있어
    // 관리자 비밀번호 없이는 열리지 않는다. 규칙이 아니라 암호가 가림막이다.
    match /barada/{document=**} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 확~마! 제자반(disciple/) — LADI 본 앱·신입생 앱과 완전히 분리된 문서.
    match /disciple/{document} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
    // 제자반 제출물 — 큐티·D형 큐티·기도 영적일지·주일 설교 노트.
    // 종류_사람_날짜로 문서를 하나씩 나눠 둔다(한 문서에 몰아넣다 통째로 잃지 않도록).
    match /discipleDocs/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // 제자반 알림 토큰 — 폰마다 하나씩. 알림을 보낼 때만 쓴다.
    match /discipleTokens/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /stateBackups/{document} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /stateSnapshots/{document} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    match /syncConflicts/{document} {
      allow read, create: if true;
      allow update, delete: if false;
    }
    // 큐티 안전사본 — 본 기록이 유실돼도 여기서 되살린다.
    match /qtSubmissions/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /qtImages/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /loveMeetingImages/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /passageImages/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    match /profiles/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // 사진첩 — 목록용 작은 사진과 한 줄 설명만 담는다(한 장에 20KB 남짓).
    // 지우기는 문서를 없애지 않고 deleted 표시를 남긴다.
    match /radiGallery/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // 사진첩 원본 — 눌러서 크게 볼 때만 받아 간다.
    match /radiGalleryImages/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
    // 내 사진에 달린 댓글 알림 — 사람마다 문서 하나. 사진이 안 들어가 가볍다.
    match /radiGalleryAlerts/{document} {
      allow read, create, update: if true;
      allow delete: if false;
    }
  }
}
